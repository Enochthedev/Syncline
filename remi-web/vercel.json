{
    "version": 2,
    "name": "remi-web",
    "alias": [
        "app.remi.com",
        "www.remi.com"
    ],
    "regions": [
        "iad1",
        "sfo1",
        "lhr1"
    ],
    "build": {
        "env": {
            "NEXT_PUBLIC_API_URL": "@remi-api-url",
            "NEXT_PUBLIC_WS_URL": "@remi-ws-url",
            "NEXT_PUBLIC_FIREBASE_CONFIG": "@remi-firebase-config",
            "NEXT_PUBLIC_ENVIRONMENT": "@remi-environment"
        }
    },
    "env": {
        "NEXT_PUBLIC_API_URL": "@remi-api-url",
        "NEXT_PUBLIC_WS_URL": "@remi-ws-url",
        "NEXT_PUBLIC_FIREBASE_CONFIG": "@remi-firebase-config",
        "NEXT_PUBLIC_ENVIRONMENT": "@remi-environment"
    },
    "functions": {
        "pages/api/**/*.js": {
            "maxDuration": 30
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/home",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/app",
            "destination": "/",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://api.remi.com/api/:path*"
        },
        {
            "source": "/ws/:path*",
            "destination": "https://ws.remi.com/ws/:path*"
        }
    ],
    "trailingSlash": false,
    "cleanUrls": true,
    "framework": "nextjs"
}