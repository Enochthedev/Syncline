# Production Environment Configuration for R.E.M.I Web App

# API Configuration
REACT_APP_API_URL=https://api.remi.ai
REACT_APP_WS_URL=wss://api.remi.ai/ws

# Feature Flags
REACT_APP_VOICE_SEARCH_ENABLED=true
REACT_APP_ADVANCED_SEARCH_ENABLED=true
REACT_APP_REAL_TIME_SYNC_ENABLED=true
REACT_APP_ANALYTICS_ENABLED=true
REACT_APP_PWA_ENABLED=true
REACT_APP_OFFLINE_ENABLED=true

# Production Settings
NODE_ENV=production
REACT_APP_ENV=production
REACT_APP_DEBUG=false

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_MIXPANEL_TOKEN=

# Error Reporting
REACT_APP_SENTRY_DSN=

# OAuth Configuration (Production)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_MICROSOFT_CLIENT_ID=