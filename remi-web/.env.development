# Development Environment Configuration for R.E.M.I Web App

# API Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# Feature Flags
REACT_APP_VOICE_SEARCH_ENABLED=true
REACT_APP_ADVANCED_SEARCH_ENABLED=true
REACT_APP_REAL_TIME_SYNC_ENABLED=true
REACT_APP_ANALYTICS_ENABLED=false
REACT_APP_PWA_ENABLED=true
REACT_APP_OFFLINE_ENABLED=true

# Development Settings
NODE_ENV=development
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# Analytics (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_MIXPANEL_TOKEN=

# Error Reporting (Optional)
REACT_APP_SENTRY_DSN=

# OAuth Configuration (Development)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_MICROSOFT_CLIENT_ID=