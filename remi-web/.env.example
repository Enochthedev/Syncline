# R.E.M.I Web App Environment Configuration
# Copy this file to .env.local and configure for your environment

# =============================================================================
# Next.js Configuration
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-here

# =============================================================================
# API Configuration
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# =============================================================================
# App Configuration
# =============================================================================
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENVIRONMENT=development
NEXT_PUBLIC_APP_NAME=R.E.M.I
NEXT_PUBLIC_APP_DESCRIPTION=Real-time External Memory Interface

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# =============================================================================
# Authentication Configuration
# =============================================================================
NEXT_PUBLIC_JWT_STORAGE_KEY=remi_auth_tokens
NEXT_PUBLIC_USER_STORAGE_KEY=remi_user_data
NEXT_PUBLIC_DEVICE_ID_KEY=remi_device_id
NEXT_PUBLIC_SECURITY_EVENTS_KEY=remi_security_events

# =============================================================================
# OAuth Configuration (for platform connections)
# =============================================================================
NEXT_PUBLIC_GMAIL_CLIENT_ID=your_gmail_client_id_here
NEXT_PUBLIC_SLACK_CLIENT_ID=your_slack_client_id_here
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here

# OAuth Redirect URIs
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# =============================================================================
# Security Configuration
# =============================================================================
NEXT_PUBLIC_CSP_NONCE=development-nonce
NEXT_PUBLIC_ENABLE_HTTPS_ONLY=false
NEXT_PUBLIC_ENABLE_HSTS=false
NEXT_PUBLIC_MAX_SECURITY_EVENTS=100

# =============================================================================
# PWA Configuration
# =============================================================================
NEXT_PUBLIC_PWA_NAME=R.E.M.I
NEXT_PUBLIC_PWA_SHORT_NAME=REMI
NEXT_PUBLIC_PWA_DESCRIPTION=Real-time External Memory Interface
NEXT_PUBLIC_PWA_THEME_COLOR=#000000
NEXT_PUBLIC_PWA_BACKGROUND_COLOR=#ffffff
NEXT_PUBLIC_PWA_DISPLAY=standalone
NEXT_PUBLIC_PWA_ORIENTATION=portrait

# =============================================================================
# Push Notifications (Web Push)
# =============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# =============================================================================
# Development Tools
# =============================================================================
NEXT_PUBLIC_ENABLE_DEVTOOLS=true
NEXT_PUBLIC_ENABLE_REDUX_DEVTOOLS=true
NEXT_PUBLIC_LOG_LEVEL=debug

# Bundle Analysis
ANALYZE=false
BUNDLE_ANALYZE=false

# =============================================================================
# Performance Configuration
# =============================================================================
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_PERFORMANCE_SAMPLE_RATE=0.1
NEXT_PUBLIC_ENABLE_WEB_VITALS=true

# =============================================================================
# Caching Configuration
# =============================================================================
NEXT_PUBLIC_CACHE_SIZE_LIMIT=50MB
NEXT_PUBLIC_OFFLINE_TIMEOUT=30000
NEXT_PUBLIC_SYNC_INTERVAL=300000

# =============================================================================
# Testing Configuration
# =============================================================================
TEST_API_BASE_URL=http://localhost:8001
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123

# Playwright Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# =============================================================================
# Analytics Configuration
# =============================================================================
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=your_analytics_write_key
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=1.0.0
NEXT_PUBLIC_SENTRY_DEBUG=true

# =============================================================================
# Database Configuration (if using direct DB access)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/remi_web
REDIS_URL=redis://localhost:6379/1

# =============================================================================
# Email Configuration (for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# Storage Configuration
# =============================================================================
NEXT_PUBLIC_STORAGE_SIZE_LIMIT=10MB
NEXT_PUBLIC_ENABLE_ENCRYPTION=true

# =============================================================================
# Network Configuration
# =============================================================================
NEXT_PUBLIC_REQUEST_TIMEOUT=30000
NEXT_PUBLIC_RETRY_ATTEMPTS=3
NEXT_PUBLIC_RETRY_DELAY=1000
NEXT_PUBLIC_CONNECTION_TIMEOUT=10000

# =============================================================================
# Localization
# =============================================================================
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,es,fr,de,ja,zh
NEXT_PUBLIC_ENABLE_RTL=false

# =============================================================================
# CDN Configuration
# =============================================================================
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com
NEXT_PUBLIC_ASSETS_URL=https://assets.yourdomain.com

# =============================================================================
# Search Configuration
# =============================================================================
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:8000/api/v1/search
NEXT_PUBLIC_SEARCH_DEBOUNCE_DELAY=300
NEXT_PUBLIC_SEARCH_MIN_QUERY_LENGTH=2

# =============================================================================
# WebSocket Configuration
# =============================================================================
NEXT_PUBLIC_WS_RECONNECT_INTERVAL=5000
NEXT_PUBLIC_WS_MAX_RECONNECT_ATTEMPTS=10
NEXT_PUBLIC_WS_HEARTBEAT_INTERVAL=30000

# =============================================================================
# Content Security Policy
# =============================================================================
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-eval' 'unsafe-inline'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:
CSP_FONT_SRC='self' data:
CSP_CONNECT_SRC='self' http://localhost:8000 ws://localhost:8000

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=your-session-secret-here
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# =============================================================================
# Monitoring Configuration
# =============================================================================
NEXT_PUBLIC_ENABLE_MONITORING=true
MONITORING_ENDPOINT=http://localhost:8000/api/v1/monitoring
HEALTH_CHECK_INTERVAL=60000

# =============================================================================
# Development Overrides
# =============================================================================
# Uncomment and modify for local development overrides
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.100:8000  # Use your local IP for network testing
# NEXT_PUBLIC_ENABLE_MOCK_AUTH=true                    # Mock authentication for testing
# NEXT_PUBLIC_SKIP_ONBOARDING=true                     # Skip onboarding flow in development
# NEXT_PUBLIC_ENABLE_DEBUG_PANEL=true                  # Show debug information panel

# =============================================================================
# Build Configuration
# =============================================================================
# These are used during build time
BUILD_STANDALONE=false
BUILD_OUTPUT=export
BUILD_TRAILING_SLASH=false
BUILD_UNOPTIMIZED=false