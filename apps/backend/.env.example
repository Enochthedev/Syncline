# =============================================================================
# R.E.M.I (Real-time External Memory Interface) Configuration
# =============================================================================

# =============================================================================
# Core Database Configuration
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mesh_development
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_PRE_PING=true

# =============================================================================
# Redis Configuration (Event Bus & Caching)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true

# =============================================================================
# Environment & Debug Settings
# =============================================================================
ENV=development
DEBUG=true
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# =============================================================================
# Security Configuration
# =============================================================================
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# =============================================================================
# Gmail Integration (OAuth 2.0)
# =============================================================================
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GMAIL_WEBHOOK_URL=https://your-domain.com/webhooks/gmail
GMAIL_WEBHOOK_SECRET=your-gmail-webhook-secret

# =============================================================================
# Yahoo Mail Integration (IMAP)
# =============================================================================
YAHOO_EMAIL=your-email@yahoo.com
YAHOO_APP_PASSWORD=your-yahoo-app-specific-password
YAHOO_IMAP_SERVER=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
YAHOO_POLLING_INTERVAL=30

# =============================================================================
# Slack Integration (Events API)
# =============================================================================
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_USER_TOKEN=xoxp-your-slack-user-token
SLACK_WEBHOOK_URL=https://your-domain.com/webhooks/slack
SLACK_SOCKET_MODE_TOKEN=xapp-your-socket-mode-token

# =============================================================================
# Discord Integration (Bot)
# =============================================================================
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_WEBHOOK_URL=https://your-domain.com/webhooks/discord

# =============================================================================
# Twitter/X Integration (API v2)
# =============================================================================
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret
X_BEARER_TOKEN=your-x-bearer-token
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_WEBHOOK_URL=https://your-domain.com/webhooks/twitter

# =============================================================================
# Telegram Integration (Bot API)
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# =============================================================================
# LinkedIn Integration (OAuth 2.0)
# =============================================================================
# To get LinkedIn API credentials:
# 1. Go to https://www.linkedin.com/developers/apps
# 2. Create a new app or select existing one
# 3. Under "Auth" tab, get Client ID and Client Secret
# 4. Add redirect URI: http://localhost:8000/api/v1/connections/callback/linkedin
# Note: Messaging API requires LinkedIn Partnership approval
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/connections/callback/linkedin
# Scopes: r_liteprofile, r_emailaddress, w_member_social
# For messaging (requires partnership): r_messaging, w_messaging
LINKEDIN_SCOPES=r_liteprofile,r_emailaddress,w_member_social

# =============================================================================
# Matrix Bridge Configuration (WhatsApp, Instagram, LinkedIn)
# =============================================================================
MATRIX_HOMESERVER_URL=https://matrix.your-domain.com
MATRIX_ACCESS_TOKEN=your-matrix-access-token
MATRIX_USER_ID=@your-user:your-domain.com
MATRIX_DEVICE_ID=your-device-id

# WhatsApp Bridge (mautrix-whatsapp)
WHATSAPP_BRIDGE_ENABLED=false
WHATSAPP_BRIDGE_EXECUTABLE=/usr/local/bin/mautrix-whatsapp
WHATSAPP_BRIDGE_CONFIG_PATH=/etc/mautrix-whatsapp/config.yaml
WHATSAPP_BRIDGE_DATABASE_PATH=/var/lib/mautrix-whatsapp/mautrix-whatsapp.db

# Instagram Bridge (mautrix-meta)
INSTAGRAM_BRIDGE_ENABLED=false
INSTAGRAM_BRIDGE_EXECUTABLE=/usr/local/bin/mautrix-meta
INSTAGRAM_BRIDGE_CONFIG_PATH=/etc/mautrix-meta/config.yaml

# LinkedIn Bridge (mautrix-linkedin)
LINKEDIN_BRIDGE_ENABLED=false
LINKEDIN_BRIDGE_EXECUTABLE=/usr/local/bin/mautrix-linkedin
LINKEDIN_BRIDGE_CONFIG_PATH=/etc/mautrix-linkedin/config.yaml

# =============================================================================
# AI Processing Configuration (Local-First)
# =============================================================================

# Primary AI Provider (local by default)
# Options: ollama, huggingface, openai, anthropic
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_CHAT_MODEL=llama3.2:3b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text:latest

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Hugging Face Configuration (Local or API)
# For local inference, leave HF_API_TOKEN empty
# For API access, provide your token from https://huggingface.co/settings/tokens
# HF_API_TOKEN=hf_your_huggingface_token
HF_CHAT_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_USE_LOCAL=true
HF_CACHE_DIR=~/.cache/huggingface

# OpenAI Configuration (Optional Cloud Fallback)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_ORG_ID=your-openai-org-id
# OPENAI_MODEL=gpt-4
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Anthropic Configuration (Optional Cloud Fallback)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# AI Processing Settings
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT=120
AI_MAX_RETRIES=3
AI_BATCH_SIZE=10
AI_CONCURRENT_REQUESTS=5

# =============================================================================
# Vector Database Configuration (ChromaDB)
# =============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./vector_db
CHROMA_COLLECTION_NAME=mesh_messages
CHROMA_DISTANCE_FUNCTION=cosine

# =============================================================================
# PII Redaction & Privacy Settings
# =============================================================================
PII_REDACTION_ENABLED=true
PII_REDACTION_PLACEHOLDER=[REDACTED]
PII_CONFIDENCE_THRESHOLD=0.8
PII_REDACTION_ENTITIES=["PERSON", "EMAIL_ADDRESS", "PHONE_NUMBER", "SSN", "CREDIT_CARD"]

# Data Retention Settings
MESSAGE_RETENTION_DAYS=365
ATTACHMENT_RETENTION_DAYS=180
LOG_RETENTION_DAYS=90
VECTOR_RETENTION_DAYS=365

# =============================================================================
# File Storage Configuration
# =============================================================================
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE=50MB

# AWS S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-s3-bucket
# S3_PREFIX=mesh-attachments/

# =============================================================================
# Rate Limiting & Circuit Breaker Configuration
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
CIRCUIT_BREAKER_EXPECTED_RECOVERY_TIME=10

# =============================================================================
# Monitoring & Observability
# =============================================================================
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10

# Logging Configuration
LOG_FILE_PATH=./logs/mesh-system.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=json

# =============================================================================
# Batch Processing Configuration
# =============================================================================
BATCH_PROCESSING_ENABLED=true
BATCH_SIZE=100
BATCH_TIMEOUT=300
BATCH_RETRY_ATTEMPTS=3

# Summary Generation Schedule (cron format)
DAILY_SUMMARY_SCHEDULE=0 6 * * *
WEEKLY_SUMMARY_SCHEDULE=0 6 * * 1
MONTHLY_SUMMARY_SCHEDULE=0 6 1 * *

# =============================================================================
# Multi-Tenant Configuration
# =============================================================================
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT_ID=default
TENANT_ISOLATION_LEVEL=database

# =============================================================================
# Webhook Configuration
# =============================================================================
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3

# =============================================================================
# Development & Testing Configuration
# =============================================================================
TESTING_MODE=false
MOCK_EXTERNAL_APIS=false
SEED_TEST_DATA=false

# Test Database (for running tests)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mesh_test

# =============================================================================
# Performance Tuning
# =============================================================================
MAX_CONCURRENT_CONNECTIONS=100
CONNECTION_POOL_SIZE=20
QUERY_TIMEOUT=30
BULK_INSERT_BATCH_SIZE=1000

# Message Processing
MESSAGE_PROCESSING_WORKERS=4
MESSAGE_QUEUE_SIZE=1000
MESSAGE_PROCESSING_TIMEOUT=60

# Search Configuration
SEARCH_RESULTS_LIMIT=100
SEARCH_TIMEOUT=10
FULL_TEXT_SEARCH_ENABLED=true
VECTOR_SEARCH_ENABLED=true

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_PROCESSING=true
FEATURE_REAL_TIME_SEARCH=true
FEATURE_PROACTIVE_MEMORY=true
FEATURE_ENTITY_EXTRACTION=true
FEATURE_SUMMARY_GENERATION=true
FEATURE_FILE_TRACKING=true
FEATURE_CONTACT_DOSSIERS=true
FEATURE_EXPERIMENTAL_CONNECTORS=false

# =============================================================================
# Experimental Features (Use with caution)
# =============================================================================
EXPERIMENTAL_TIKTOK_ENABLED=false
EXPERIMENTAL_SNAPCHAT_ENABLED=false
EXPERIMENTAL_ADVANCED_AI=false
# =============================================================================
# Mobile App Configuration
# =============================================================================
# Deep link scheme for OAuth callbacks
APP_DEEP_LINK_SCHEME=syncline

