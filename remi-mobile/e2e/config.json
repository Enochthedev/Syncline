{
  "testEnvironment": "node",
  "testRunner": "jest",
  "testTimeout": 120000,
  "testRegex": "\\.e2e\\.(js|ts)$",
  "reporters": [
    "default",
    ["jest-junit", {
      "outputDirectory": "e2e/test-results",
      "outputName": "detox-results.xml"
    }]
  ],
  "verbose": true,
  "setupFilesAfterEnv": ["<rootDir>/e2e/setup.ts"]
}