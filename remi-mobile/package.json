{
  "name": "remi-mobile",
  "version": "1.0.0",
  "description": "R.E.M.I React Native Mobile Application with Contact-Based Auto-Search",
  "main": "index.js",
  "scripts": {
    "dev": "REACT_NATIVE_NO_WATCHMAN=1 DISABLE_WATCHMAN=1 react-native start --reset-cache",
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "qr": "./scripts/deploy.sh qr",
    "qr:info": "./scripts/deploy.sh info",
    "qr:server": "node scripts/qr-server.js",
    "deploy": "./scripts/deploy.sh",
    "deploy:dev": "./scripts/deploy.sh dev",
    "deploy:qr": "./scripts/deploy.sh qr",
    "deploy:build": "./scripts/deploy.sh build",
    "deploy:install": "./scripts/deploy.sh install",
    "deploy:fix": "./scripts/deploy.sh fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/unit --coverage",
    "test:integration": "jest __tests__/integration --coverage",
    "test:performance": "jest __tests__/performance --coverage",
    "test:visual": "jest __tests__/visual --coverage",
    "test:security": "jest __tests__/security --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance && npm run test:visual && npm run test:security",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "detox test --configuration android.emu.debug",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "build:ios": "react-native run-ios --configuration Release",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "react-native clean-project-auto",
    "codepush:ios": "appcenter codepush release-react remi-mobile-ios ios",
    "codepush:android": "appcenter codepush release-react remi-mobile-android android",
    "codepush:staging:ios": "appcenter codepush release-react remi-mobile-ios ios -d Staging",
    "codepush:staging:android": "appcenter codepush release-react remi-mobile-android android -d Staging",
    "codepush:production:ios": "appcenter codepush release-react remi-mobile-ios ios -d Production",
    "codepush:production:android": "appcenter codepush release-react remi-mobile-android android -d Production",
    "deploy:ios:beta": "cd ios && bundle exec fastlane beta",
    "deploy:ios:release": "cd ios && bundle exec fastlane deploy_to_app_store",
    "deploy:android:beta": "cd android && bundle exec fastlane beta",
    "deploy:android:release": "cd android && bundle exec fastlane deploy_to_play_store",
    "version:patch": "npm version patch && git push --tags",
    "version:minor": "npm version minor && git push --tags",
    "version:major": "npm version major && git push --tags"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-native-community/netinfo": "9.3.10",
    "@react-native-firebase/analytics": "^18.6.1",
    "@react-native-firebase/app": "^18.6.1",
    "@react-native-firebase/crashlytics": "^18.6.1",
    "@react-native-firebase/messaging": "^18.6.1",
    "@react-native-firebase/perf": "^18.6.1",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@tanstack/react-query": "^4.36.1",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^2.30.0",
    "jail-monkey": "^2.7.0",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "react-native-animatable": "^1.3.3",
    "react-native-background-job": "^1.2.3",
    "react-native-biometrics": "^3.0.1",
    "react-native-contacts": "^7.0.8",
    "react-native-device-info": "^10.11.0",
    "react-native-document-picker": "^9.1.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-image-picker": "^7.0.3",
    "react-native-keychain": "^8.1.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^13.0.1",
    "react-native-permissions": "^3.10.1",
    "react-native-push-notification": "^8.1.1",
    "react-native-reanimated": "~3.3.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-share": "^9.4.1",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "13.9.0",
    "react-native-touch-id": "^4.4.1",
    "react-native-vector-icons": "^10.0.2",
    "react-native-code-push": "^8.2.1",
    "typescript": "^5.1.3",
    "zustand": "^4.4.4",
    "expo": "~49.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@tsconfig/react-native": "^3.0.0",
    "@types/crypto-js": "^4.2.1",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.200",
    "@types/react": "~18.2.14",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "detox": "^20.13.5",
    "jest-junit": "^16.0.0",
    "pixelmatch": "^5.3.0",
    "react-native-screenshot-tests": "^2.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "reactotron-react-native": "^5.0.3",
    "reactotron-redux": "^3.1.3",
    "appcenter-cli": "^2.13.6",
    "conventional-changelog-cli": "^4.1.0",
    "semantic-release": "^22.0.5"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-vector-icons|react-native-reanimated|@react-navigation)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{js,jsx,ts,tsx}",
      "!src/**/index.{js,jsx,ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "detox": {
    "test-runner": "jest",
    "runner-config": "e2e/config.json",
    "configurations": {
      "ios.sim.debug": {
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/RemiMobile.app",
        "build": "xcodebuild -workspace ios/RemiMobile.xcworkspace -scheme RemiMobile -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 14"
        }
      },
      "android.emu.debug": {
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug && cd ..",
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_4_API_30"
        }
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/remi-mobile.git"
  },
  "keywords": [
    "react-native",
    "mobile",
    "contact-search",
    "real-time",
    "communication",
    "ai",
    "typescript"
  ],
  "author": "R.E.M.I Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-org/remi-mobile/issues"
  },
  "homepage": "https://github.com/your-org/remi-mobile#readme"
}