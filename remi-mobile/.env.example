# R.E.M.I Mobile App Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# API Configuration
# =============================================================================
API_BASE_URL=http://localhost:8000
WS_URL=ws://localhost:8000/ws

# =============================================================================
# App Configuration
# =============================================================================
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_NAME=R.E.M.I

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
ENABLE_OFFLINE_MODE=true

# =============================================================================
# Authentication Configuration
# =============================================================================
JWT_STORAGE_KEY=remi_auth_tokens
USER_STORAGE_KEY=remi_user_data
DEVICE_ID_KEY=remi_device_id
BIOMETRIC_KEY=remi_biometric_key

# =============================================================================
# OAuth Configuration (for platform connections)
# =============================================================================
GMAIL_CLIENT_ID=your_gmail_client_id_here
SLACK_CLIENT_ID=your_slack_client_id_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# OAuth Redirect Schemes
OAUTH_REDIRECT_SCHEME=com.remimobile

# =============================================================================
# Security Configuration
# =============================================================================
KEYCHAIN_SERVICE=remi-auth
ENABLE_SSL_PINNING=false
SECURITY_EVENTS_KEY=remi_security_events
MAX_SECURITY_EVENTS=100

# =============================================================================
# Push Notifications (Firebase)
# =============================================================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# =============================================================================
# Development Tools
# =============================================================================
ENABLE_FLIPPER=true
ENABLE_REACTOTRON=true
ENABLE_DEV_MENU=true
LOG_LEVEL=debug

# Flipper Configuration
FLIPPER_HOST=localhost
FLIPPER_PORT=8089

# Reactotron Configuration
REACTOTRON_HOST=localhost
REACTOTRON_PORT=9090

# =============================================================================
# Performance Configuration
# =============================================================================
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1
ENABLE_MEMORY_MONITORING=true

# =============================================================================
# Offline Configuration
# =============================================================================
CACHE_SIZE_LIMIT=50MB
OFFLINE_TIMEOUT=30000
SYNC_INTERVAL=300000

# =============================================================================
# Testing Configuration
# =============================================================================
TEST_API_BASE_URL=http://localhost:8001
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123

# E2E Testing
DETOX_CONFIGURATION=ios.sim.debug
E2E_TIMEOUT=120000

# =============================================================================
# CodePush Configuration (for OTA updates)
# =============================================================================
CODEPUSH_DEPLOYMENT_KEY_IOS=your_ios_deployment_key
CODEPUSH_DEPLOYMENT_KEY_ANDROID=your_android_deployment_key
CODEPUSH_CHECK_FREQUENCY=ON_APP_RESUME

# =============================================================================
# Analytics Configuration
# =============================================================================
ANALYTICS_WRITE_KEY=your_analytics_write_key
ANALYTICS_DEBUG=false
ANALYTICS_FLUSH_AT=20

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0
SENTRY_DEBUG=true

# =============================================================================
# Biometric Configuration
# =============================================================================
BIOMETRIC_PROMPT_TITLE=Authenticate to R.E.M.I
BIOMETRIC_PROMPT_SUBTITLE=Use your biometric to access your account
BIOMETRIC_PROMPT_DESCRIPTION=Place your finger on the sensor or look at the camera
BIOMETRIC_PROMPT_NEGATIVE_BUTTON=Cancel

# =============================================================================
# Network Configuration
# =============================================================================
REQUEST_TIMEOUT=30000
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
CONNECTION_TIMEOUT=10000

# =============================================================================
# Storage Configuration
# =============================================================================
ASYNC_STORAGE_SIZE_LIMIT=10MB
SECURE_STORAGE_ACCESS_GROUP=group.com.remimobile.shared

# =============================================================================
# Localization
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ja,zh
ENABLE_RTL=false

# =============================================================================
# Deep Linking
# =============================================================================
DEEP_LINK_SCHEME=remi
UNIVERSAL_LINK_DOMAIN=remi.app

# =============================================================================
# Background Tasks
# =============================================================================
BACKGROUND_SYNC_INTERVAL=900000
BACKGROUND_FETCH_INTERVAL=3600000
ENABLE_BACKGROUND_PROCESSING=true

# =============================================================================
# Development Overrides
# =============================================================================
# Uncomment and modify for local development overrides
# API_BASE_URL=http://192.168.1.100:8000  # Use your local IP for device testing
# ENABLE_MOCK_BIOMETRICS=true             # Mock biometric responses for testing
# SKIP_ONBOARDING=true                     # Skip onboarding flow in development