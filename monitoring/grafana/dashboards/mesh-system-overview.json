{
    "dashboard": {
        "id": null,
        "title": "MESH System Overview",
        "tags": [
            "mesh",
            "system",
            "overview"
        ],
        "style": "dark",
        "timezone": "browser",
        "refresh": "30s",
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "System Health Status",
                "type": "stat",
                "targets": [
                    {
                        "expr": "mesh_connector_health",
                        "legendFormat": "{{platform}} - {{connector_type}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "red",
                                    "value": 0
                                },
                                {
                                    "color": "green",
                                    "value": 1
                                }
                            ]
                        }
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Message Ingestion Rate",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_messages_ingested_total[5m])",
                        "legendFormat": "{{platform}} - {{status}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Messages/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "API Request Rate",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_api_requests_total[5m])",
                        "legendFormat": "{{method}} {{endpoint}} - {{status_code}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Requests/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                }
            },
            {
                "id": 4,
                "title": "API Response Times",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(mesh_api_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "95th percentile"
                    },
                    {
                        "expr": "histogram_quantile(0.50, rate(mesh_api_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "50th percentile"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Seconds",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                }
            },
            {
                "id": 5,
                "title": "AI Processing Performance",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_ai_operations_total[5m])",
                        "legendFormat": "{{agent_type}} - {{operation}} - {{status}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Operations/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                }
            },
            {
                "id": 6,
                "title": "Database Operations",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_database_operations_total[5m])",
                        "legendFormat": "{{operation}} - {{table}} - {{status}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Operations/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                }
            },
            {
                "id": 7,
                "title": "Active Connections",
                "type": "stat",
                "targets": [
                    {
                        "expr": "mesh_active_connections",
                        "legendFormat": "{{connection_type}}"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "palette-classic"
                        }
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 6,
                    "x": 0,
                    "y": 24
                }
            },
            {
                "id": 8,
                "title": "Memory Usage",
                "type": "graph",
                "targets": [
                    {
                        "expr": "mesh_memory_usage_bytes",
                        "legendFormat": "{{component}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Bytes",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 18,
                    "x": 6,
                    "y": 24
                }
            }
        ]
    }
}