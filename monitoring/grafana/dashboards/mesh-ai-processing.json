{
    "dashboard": {
        "id": null,
        "title": "MESH AI Processing",
        "tags": [
            "mesh",
            "ai",
            "processing"
        ],
        "style": "dark",
        "timezone": "browser",
        "refresh": "30s",
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "AI Operations Rate",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_ai_operations_total{status=\"success\"}[5m])",
                        "legendFormat": "{{agent_type}} - {{operation}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Operations/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "AI Processing Errors",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_ai_operations_total{status!=\"success\"}[5m])",
                        "legendFormat": "{{agent_type}} - {{operation}} - {{status}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Errors/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "AI Processing Latency",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(mesh_ai_processing_duration_seconds_bucket[5m]))",
                        "legendFormat": "95th percentile - {{agent_type}} - {{operation}}"
                    },
                    {
                        "expr": "histogram_quantile(0.50, rate(mesh_ai_processing_duration_seconds_bucket[5m]))",
                        "legendFormat": "50th percentile - {{agent_type}} - {{operation}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Seconds",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 8
                }
            },
            {
                "id": 4,
                "title": "Vector Database Operations",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_vector_operations_total[5m])",
                        "legendFormat": "{{operation}} - {{status}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Operations/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                }
            },
            {
                "id": 5,
                "title": "Vector Database Latency",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(mesh_vector_operation_duration_seconds_bucket[5m]))",
                        "legendFormat": "95th percentile - {{operation}}"
                    },
                    {
                        "expr": "histogram_quantile(0.50, rate(mesh_vector_operation_duration_seconds_bucket[5m]))",
                        "legendFormat": "50th percentile - {{operation}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Seconds",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                }
            },
            {
                "id": 6,
                "title": "Search Query Performance",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(mesh_search_queries_total[5m])",
                        "legendFormat": "{{query_type}} - {{status}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Queries/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 24
                }
            },
            {
                "id": 7,
                "title": "Search Query Latency",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(mesh_search_duration_seconds_bucket[5m]))",
                        "legendFormat": "95th percentile - {{query_type}}"
                    },
                    {
                        "expr": "histogram_quantile(0.50, rate(mesh_search_duration_seconds_bucket[5m]))",
                        "legendFormat": "50th percentile - {{query_type}}"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Seconds",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 24
                }
            }
        ]
    }
}